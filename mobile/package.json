{
  "name": "rechargealert",
  "version": "0.0.1",
  "description": "DESCO prepaid recharge / low-balance alerts",
  "productName": "RechargeAlert",
  "author": "Md. Shamim Miah <shamim.miah@itconquest.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:android": "quasar dev -m capacitor -T android --hostname 192.168.0.103",
    "dev:ios": "quasar dev -m capacitor -T ios --hostname 192.168.0.103",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.2",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
